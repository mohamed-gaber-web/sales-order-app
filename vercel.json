{
  "buildCommand": "npm run build -- --configuration=production",
  "outputDirectory": "www",
  "rewrites": [
    {
      "source": "/api/portal/:path*",
      "destination": "https://admin-portal-production-db9b.up.railway.app/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
