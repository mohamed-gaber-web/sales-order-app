{
  "buildCommand": "npm run build -- --configuration=production",
  "outputDirectory": "www",
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "/api/d365/data/:path*"
    },
    {
      "source": "/api/services/:path*",
      "destination": "/api/d365/api/services/:path*"
    },
    {
      "source": "/((?!api/|data/).*)",
      "destination": "/index.html"
    }
  ]
}
